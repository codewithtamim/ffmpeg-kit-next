+/*
+ * Whether this Annex B HEVC packet carries a real IRAP NAL (BLA/IDR/CRA,
+ * types 16-23) rather than just a BUFFER_FLAG_KEY_FRAME claim from the
+ * codec. Not applied to H.264: this was only ever observed on a hardware
+ * HEVC encoder, and gating every AVC encoder on this check as well would be
+ * an unverified, broader behavior change.
+ *
+ * Qualcomm's c2.qti.hevc.encoder (seen on the Galaxy S24 Ultra, SM8650) marks
+ * every periodic "sync frame" it emits as a key frame in BufferInfo.flags,
+ * but for the lifetime of one encode only ever writes a single true IDR NAL:
+ * every later "sync frame" is coded as an ordinary TRAIL_R picture that
+ * happens to be intra. The GOP structure the platform exposes to force real
+ * periodic IDRs (coding.gop) is a vector-typed C2 parameter that FFmpeg's
+ * generic AMediaFormat configuration cannot set (it is dropped during
+ * configure with "ignored struct field coding.gop.values"), so -g alone
+ * cannot produce them on this encoder.
+ *
+ * A player that seeks to one of those mislabeled packets flushes its decoder
+ * and feeds it a picture with no reference context to decode from, which
+ * plausibly explains the reported MKV/MOV seek freeze and, since the resumed
+ * player likely seeks back to its last position the same way, the black
+ * screen after returning from Settings too — but that second half is not
+ * independently confirmed. Flagging only packets that actually start with an
+ * IRAP NAL keeps the container's seek table honest: every seek decodes from
+ * the one real IDR instead of handing the decoder a picture it cannot resync
+ * from, so it finishes instead of sticking. It does not make the encoder
+ * produce more IDRs, so a long clip still has exactly one real seek point,
+ * at t=0, until that is fixed too (see the patch header).
+ */
+static int mce_packet_has_irap_nal(int codec_id, const uint8_t *data, size_t size)
+{
+    size_t rd = 0;
+
+    if (codec_id != AV_CODEC_ID_HEVC)
+        return 1;
+
+    while (rd < size) {
+        size_t sc = 0, start, next;
+        int type;
+
+        if (rd + 3 <= size && data[rd] == 0 && data[rd + 1] == 0 &&
+            data[rd + 2] == 1)
+            sc = 3;
+        else if (rd + 4 <= size && data[rd] == 0 && data[rd + 1] == 0 &&
+                 data[rd + 2] == 0 && data[rd + 3] == 1)
+            sc = 4;
+
+        if (!sc) {
+            rd++;
+            continue;
+        }
+
+        start = rd + sc;
+        next  = start;
+        while (next + 3 <= size &&
+               !(data[next] == 0 && data[next + 1] == 0 &&
+                 data[next + 2] == 1) &&
+               !(next + 4 <= size && data[next] == 0 && data[next + 1] == 0 &&
+                 data[next + 2] == 0 && data[next + 3] == 1))
+            next++;
+        if (next + 3 > size)
+            next = size;
+
+        type = mce_nal_type(codec_id, data + start, next - start);
+        if (type >= 16 && type <= 23)
+            return 1;
+
+        rd = next;
+    }
+
+    return 0;
+}
