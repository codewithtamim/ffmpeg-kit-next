+/*
+ * Requests a real sync/IDR frame for the next input frame, via MediaCodec's
+ * "request-sync" runtime parameter (AMEDIACODEC_KEY_REQUEST_SYNC_FRAME, whose
+ * value is the literal string below; used directly rather than the symbol so
+ * this links against NDKs older than its API 31 introduction). codec->setParameters
+ * is itself resolved with dlsym and is null before API 26, so this becomes a
+ * no-op returning AVERROR(ENOSYS) there.
+ */
+static int mediacodec_ndk_requestSyncFrame(FFAMediaCodec *ctx)
+{
+    FFAMediaCodecNdk *codec = (FFAMediaCodecNdk *)ctx;
+    AMediaFormat *params;
+    media_status_t status;
+
+    if (!codec->setParameters)
+        return AVERROR(ENOSYS);
+
+    params = AMediaFormat_new();
+    if (!params)
+        return AVERROR(ENOMEM);
+
+    AMediaFormat_setInt32(params, "request-sync", 0);
+    status = codec->setParameters(codec->impl, params);
+    AMediaFormat_delete(params);
+
+    if (status != AMEDIA_OK) {
+        av_log(codec, AV_LOG_DEBUG, "requestSyncFrame failed, %d\n", status);
+        return AVERROR_EXTERNAL;
+    }
+    av_log(codec, AV_LOG_DEBUG, "requestSyncFrame success\n");
+
+    return 0;
+}
