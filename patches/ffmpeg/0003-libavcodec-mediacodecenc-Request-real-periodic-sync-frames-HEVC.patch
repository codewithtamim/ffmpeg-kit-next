+/*
+ * Requests a real sync/IDR frame for the next input frame, via MediaCodec's
+ * "request-sync" runtime parameter (PARAMETER_KEY_REQUEST_SYNC_FRAME). All
+ * three handles are resolved as optional JNI members (setParameters,
+ * Bundle's constructor and putInt), since setParameters is only available
+ * from API 26 — a device below that, or any ROM missing it, leaves one of
+ * these null and this becomes a no-op returning AVERROR(ENOSYS), same as
+ * signalEndOfInputStream's guard for FFANativeWindow input.
+ */
+static int mediacodec_jni_requestSyncFrame(FFAMediaCodec *ctx)
+{
+    JNIEnv *env = NULL;
+    FFAMediaCodecJni *codec = (FFAMediaCodecJni *)ctx;
+    jobject bundle = NULL;
+    jstring key = NULL;
+    int ret = 0;
+
+    JNI_GET_ENV_OR_RETURN(env, codec, AVERROR_EXTERNAL);
+
+    if (!codec->jfields.set_parameters_id || !codec->jfields.bundle_class ||
+        !codec->jfields.bundle_init_id || !codec->jfields.bundle_put_int_id) {
+        return AVERROR(ENOSYS);
+    }
+
+    // The exception check runs first and unconditionally: a failed NewObject
+    // or NewStringUTF leaves a pending exception that corrupts the next JNI
+    // call on this thread if it isn't cleared here, whether or not the
+    // handle itself came back null.
+    bundle = (*env)->NewObject(env, codec->jfields.bundle_class, codec->jfields.bundle_init_id);
+    if (ff_jni_exception_check(env, 1, codec) < 0 || !bundle) {
+        ret = AVERROR_EXTERNAL;
+        goto done;
+    }
+
+    key = (*env)->NewStringUTF(env, "request-sync");
+    if (ff_jni_exception_check(env, 1, codec) < 0 || !key) {
+        ret = AVERROR_EXTERNAL;
+        goto done;
+    }
+
+    (*env)->CallVoidMethod(env, bundle, codec->jfields.bundle_put_int_id, key, 0);
+    if (ff_jni_exception_check(env, 1, codec) < 0) {
+        ret = AVERROR_EXTERNAL;
+        goto done;
+    }
+
+    (*env)->CallVoidMethod(env, codec->object, codec->jfields.set_parameters_id, bundle);
+    if (ff_jni_exception_check(env, 1, codec) < 0) {
+        ret = AVERROR_EXTERNAL;
+        goto done;
+    }
+
+done:
+    if (key)
+        (*env)->DeleteLocalRef(env, key);
+    if (bundle)
+        (*env)->DeleteLocalRef(env, bundle);
+    return ret;
+}
