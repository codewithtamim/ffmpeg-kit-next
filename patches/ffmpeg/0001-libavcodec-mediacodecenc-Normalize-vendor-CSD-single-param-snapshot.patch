+/*
+ * Drop parameter-set NALs from an Annex B access unit in place, keeping
+ * every other NAL and its start code verbatim. Used when the container
+ * header already carries the parameter sets: otherwise extract_extradata
+ * re-emits new-extradata side data and muxers like FLV rewrite a second
+ * header block — a second CSD snapshot in one file again. Returns the new
+ * size.
+ */
+static size_t mce_strip_parameter_nals(int codec_id, uint8_t *data,
+                                       size_t size)
+{
+    size_t rd = 0, wr = 0;
+
+    while (rd < size) {
+        size_t sc = 0, start, next;
+
+        if (rd + 3 <= size && data[rd] == 0 && data[rd + 1] == 0 &&
+            data[rd + 2] == 1)
+            sc = 3;
+        else if (rd + 4 <= size && data[rd] == 0 && data[rd + 1] == 0 &&
+                 data[rd + 2] == 0 && data[rd + 3] == 1)
+            sc = 4;
+
+        if (!sc) {
+            data[wr++] = data[rd++];
+            continue;
+        }
+
+        start = rd + sc;
+        next  = start;
+        while (next + 3 <= size &&
+               !(data[next] == 0 && data[next + 1] == 0 &&
+                 data[next + 2] == 1) &&
+               !(next + 4 <= size && data[next] == 0 && data[next + 1] == 0 &&
+                 data[next + 2] == 0 && data[next + 3] == 1))
+            next++;
+        if (next + 3 > size)
+            next = size;
+
+        if (!mce_is_parameter_nal(codec_id,
+                                  mce_nal_type(codec_id, data + start,
+                                               next - start)))
+            memmove(data + wr, data + rd, next - rd);
+
+        rd = next;
+    }
+
+    return wr;
+}
