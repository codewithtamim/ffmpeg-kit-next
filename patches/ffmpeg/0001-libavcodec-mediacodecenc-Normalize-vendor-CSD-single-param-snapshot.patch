+/*
+ * Collect parameter sets from an avcC/hvcC shaped record. The declared NAL
+ * length size and the one the vendor used may disagree, so every plausible
+ * length size is attempted and the first one that yields a fully valid
+ * parameter-set walk wins. Bytes trailing the last enumerated array (vendor
+ * padding) are ignored.
+ */
+static void mce_collect_record(int codec_id, const uint8_t *buf, size_t size,
+                               const uint8_t *nal_data[],
+                               size_t nal_size[], int seen[])
+{
+    const uint8_t *tmp_data[MCE_MAX_PARAMETER_SETS];
+    size_t tmp_size[MCE_MAX_PARAMETER_SETS];
+    int tmp_seen[MCE_MAX_PARAMETER_SETS];
+    size_t declared, cand[3];
+    int ncand = 0, c;
+
+    if (codec_id == AV_CODEC_ID_H264 && size >= 7)
+        declared = (buf[4] & 0x03) + 1;
+    else if (codec_id == AV_CODEC_ID_HEVC && size >= 23)
+        declared = (buf[21] & 0x03) + 1;
+    else
+        return;
+
+    cand[ncand++] = declared;
+    if (declared != 4)
+        cand[ncand++] = 4;
+    if (declared != 2)
+        cand[ncand++] = 2;
+
+    for (c = 0; c < ncand; c++) {
+        size_t ls = cand[c], p;
+        int ok = 1, i;
+
+        memset(tmp_data, 0, sizeof(tmp_data));
+        memset(tmp_size, 0, sizeof(tmp_size));
+        memset(tmp_seen, 0, sizeof(tmp_seen));
+
+        if (codec_id == AV_CODEC_ID_H264) {
+            int n = buf[5] & 0x1f;
+
+            p = 6;
+            for (i = 0; i < n; i++) {
+                uint64_t len = 0;
+                int b, type;
+
+                if (p + ls > size) { ok = 0; break; }
+                for (b = 0; b < (int)ls; b++)
+                    len = (len << 8) | buf[p + b];
+                p += ls;
+                if (len == 0 || len > size - p) { ok = 0; break; }
+                type = mce_nal_type(AV_CODEC_ID_H264, buf + p, len);
+                if (type != 7) { ok = 0; break; }
+                mce_collect_nal(AV_CODEC_ID_H264, type, buf + p, len,
+                                tmp_data, tmp_size, tmp_seen);
+                p += len;
+            }
+
+            if (ok && p + 1 <= size) {
+                int m = buf[p++] & 0x1f;
+
+                for (i = 0; i < m && ok; i++) {
+                    uint64_t len = 0;
+                    int b, type;
+
+                    if (p + ls > size) { ok = 0; break; }
+                    for (b = 0; b < (int)ls; b++)
+                        len = (len << 8) | buf[p + b];
+                    p += ls;
+                    if (len == 0 || len > size - p) { ok = 0; break; }
+                    type = mce_nal_type(AV_CODEC_ID_H264, buf + p, len);
+                    if (type != 8) { ok = 0; break; }
+                    mce_collect_nal(AV_CODEC_ID_H264, type, buf + p, len,
+                                    tmp_data, tmp_size, tmp_seen);
+                    p += len;
+                }
+            } else
+                ok = 0;
+
+            if (ok && tmp_seen[0] && tmp_seen[1]) {
+                int k;
+
+                for (k = 0; k < MCE_MAX_PARAMETER_SETS; k++)
+                    if (tmp_seen[k]) {
+                        nal_data[k] = tmp_data[k];
+                        nal_size[k] = tmp_size[k];
+                        seen[k]     = 1;
+                    }
+                return;
+            }
+        } else {
+            int narrays = buf[22], a;
+
+            p = 23;
+            for (a = 0; a < narrays && ok; a++) {
+                int kind, m;
+
+                if (p + 2 > size) { ok = 0; break; }
+                kind = (buf[p] >> 1) & 0x3f;
+                m    = buf[p + 1];
+                p   += 2;
+                for (i = 0; i < m && ok; i++) {
+                    uint64_t len = 0;
+                    int b, type;
+
+                    if (p + ls > size) { ok = 0; break; }
+                    for (b = 0; b < (int)ls; b++)
+                        len = (len << 8) | buf[p + b];
+                    p += ls;
+                    if (len == 0 || len > size - p) { ok = 0; break; }
+                    type = mce_nal_type(AV_CODEC_ID_HEVC, buf + p, len);
+                    if (type != kind) { ok = 0; break; }
+                    mce_collect_nal(AV_CODEC_ID_HEVC, type, buf + p, len,
+                                    tmp_data, tmp_size, tmp_seen);
+                    p += len;
+                }
+            }
+
+            if (ok && tmp_seen[1] && tmp_seen[2]) {
+                int k;
+
+                for (k = 0; k < MCE_MAX_PARAMETER_SETS; k++)
+                    if (tmp_seen[k]) {
+                        nal_data[k] = tmp_data[k];
+                        nal_size[k] = tmp_size[k];
+                        seen[k]     = 1;
+                    }
+                return;
+            }
+        }
+    }
+}
