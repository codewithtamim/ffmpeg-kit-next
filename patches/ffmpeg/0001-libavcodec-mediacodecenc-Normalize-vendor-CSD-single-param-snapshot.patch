+/*
+ * Normalizing vendor CSD. Hardware encoders hand out their parameter sets
+ * more than once: once in a CSD buffer, again inline with the next frame. A
+ * packet that carries both copies lets extract_extradata collect them all,
+ * and the container header built from that pool ends up with duplicated
+ * SPS/PPS entries (AVC records counting 2x SPS and 2x PPS were pulled from
+ * real device output; consumers reconfiguring from the header on a seek or
+ * surface change then initialize from the wrong snapshot while linear
+ * playback survives on the clean inline copies — the observed FLV black
+ * screens and MKV/MOV seek freezes). Some encoders also emit the CSD as an
+ * avcC/hvcC-shaped record instead of Annex B, which container writers would
+ * persist verbatim. Repair every CSD once, where it enters the wrapper: one
+ * Annex B copy of each parameter set, nothing else.
+ */
+
+#define MCE_MAX_PARAMETER_SETS 3
+
+/* SPS(7)/PPS(8) for H.264, VPS(32)/SPS(33)/PPS(34) for HEVC. */
+static int mce_is_parameter_nal(int codec_id, int type)
+{
+    if (codec_id == AV_CODEC_ID_H264)
+        return type == 7 || type == 8;
+    if (codec_id == AV_CODEC_ID_HEVC)
+        return type == 32 || type == 33 || type == 34;
+    return 0;
+}
+
+static int mce_nal_type(int codec_id, const uint8_t *buf, size_t size)
+{
+    if (size < 1)
+        return -1;
+    if (codec_id == AV_CODEC_ID_H264)
+        return buf[0] & 0x1f;
+    if (codec_id == AV_CODEC_ID_HEVC)
+        return (buf[0] >> 1) & 0x3f;
+    return -1;
+}
+
+/*
+ * Collect a parameter-set NAL unless the type was collected already; only
+ * the first copy of every type is kept.
+ */
+static void mce_collect_nal(int codec_id, int type, const uint8_t *buf,
+                            size_t size, const uint8_t *nal_data[],
+                            size_t nal_size[], int seen[])
+{
+    int slot;
+
+    if (size == 0 || !mce_is_parameter_nal(codec_id, type))
+        return;
+
+    slot = codec_id == AV_CODEC_ID_H264 ? type - 7 : type - 32;
+    if (slot < 0 || slot >= MCE_MAX_PARAMETER_SETS || seen[slot])
+        return;
+
+    seen[slot]     = 1;
+    nal_data[slot] = buf;
+    nal_size[slot] = size;
+}
+
+/* Collect the parameter sets carried by an Annex B (start code framed) CSD. */
+static void mce_collect_annexb(int codec_id, const uint8_t *buf, size_t size,
+                               const uint8_t *nal_data[],
+                               size_t nal_size[], int seen[])
+{
+    size_t i = 0;
+
+    while (i + 3 <= size) {
+        size_t sc, start, end;
+        int type;
+
+        if (buf[i] == 0 && buf[i + 1] == 0 && buf[i + 2] == 1)
+            sc = 3;
+        else if (i + 4 <= size && buf[i] == 0 && buf[i + 1] == 0 &&
+                 buf[i + 2] == 0 && buf[i + 3] == 1)
+            sc = 4;
+        else {
+            i++;
+            continue;
+        }
+
+        start = i + sc;
+        end   = start + 1;
+        while (end + 3 <= size &&
+               !(buf[end] == 0 && buf[end + 1] == 0 && buf[end + 2] == 1) &&
+               !(end + 4 <= size && buf[end] == 0 && buf[end + 1] == 0 &&
+                 buf[end + 2] == 0 && buf[end + 3] == 1))
+            end++;
+        if (end + 3 > size)
+            end = size;
+
+        if (end > start) {
+            type = mce_nal_type(codec_id, buf + start, end - start);
+            mce_collect_nal(codec_id, type, buf + start, end - start,
+                            nal_data, nal_size, seen);
+        }
+
+        i = end;
+    }
+}
