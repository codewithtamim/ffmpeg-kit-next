+/*
+ * Turn a CSD into a plain, deduplicated Annex B parameter-set block:
+ * { 00 00 00 01 } SPS ... { 00 00 00 01 } PPS (a VPS first for HEVC).
+ * Returns a malloc()'d, zero padded buffer in *out / *out_size. Returns
+ * < 0 when the buffer carries nothing that can be normalized; the caller
+ * then keeps the original bytes and no buffer is allocated.
+ */
+static int mediacodec_normalize_csd(void *logctx, int codec_id, const uint8_t *buf,
+                             size_t size, uint8_t **out, size_t *out_size)
+{
+    const uint8_t *nal_data[MCE_MAX_PARAMETER_SETS];
+    size_t nal_size[MCE_MAX_PARAMETER_SETS];
+    int seen[MCE_MAX_PARAMETER_SETS] = { 0 };
+    size_t total = 0, offset = 0;
+    uint8_t *dst;
+    int i;
+
+    *out      = NULL;
+    *out_size = 0;
+
+    if (!buf || size < 4)
+        return AVERROR(EINVAL);
+
+    memset(nal_data, 0, sizeof(nal_data));
+    memset(nal_size, 0, sizeof(nal_size));
+
+    if (buf[0] == 0x01)
+        mce_collect_record(codec_id, buf, size, nal_data, nal_size, seen);
+    if (!seen[0] && !seen[1] && !seen[2]) {
+        memset(seen, 0, sizeof(seen));
+        mce_collect_annexb(codec_id, buf, size, nal_data, nal_size, seen);
+    }
+
+    if (codec_id == AV_CODEC_ID_H264 ? !seen[0] || !seen[1]
+                                     : !seen[1] || !seen[2])
+        return AVERROR(EINVAL);
+
+    for (i = 0; i < MCE_MAX_PARAMETER_SETS; i++)
+        if (seen[i])
+            total += 4 + nal_size[i];
+
+    dst = av_mallocz(total + AV_INPUT_BUFFER_PADDING_SIZE);
+    if (!dst)
+        return AVERROR(ENOMEM);
+
+    for (i = 0; i < MCE_MAX_PARAMETER_SETS; i++) {
+        if (!seen[i])
+            continue;
+        AV_WB32(dst + offset, 1);
+        memcpy(dst + offset + 4, nal_data[i], nal_size[i]);
+        offset += 4 + nal_size[i];
+    }
+
+    if (total != size)
+        av_log(logctx, AV_LOG_INFO,
+               "CSD normalized: %d bytes in, %d bytes out\n",
+               (int)size, (int)total);
+    else
+        av_log(logctx, AV_LOG_VERBOSE, "CSD already normalized\n");
+
+    *out      = dst;
+    *out_size = total;
+    return 0;
+}
